rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}
//   - uid: string
//   - roles: list<string> (multi-role array, e.g. ['police', 'owner'], ['agent', 'owner'], ['owner'])
//   - Writes are restricted to Cloud Functions (Admin SDK).
//
// Collection: reports/{reportId}
//   - agentId: string
//   - plateNumber: string
//   - status: string ('pending' | 'investigated' | 'resolved')
//   - Writes are restricted to Cloud Functions (Admin SDK).
//
// Collection: fines/{fineId}
//   - ownerId: string
//   - reportId: string
//   - status: string ('unpaid' | 'paid' | 'cancelled')
//   - Writes are restricted to Cloud Functions (Admin SDK).
//
// Collection: cars/{carId}
//   - ownerId: string
//   - ownershipHistory: list<string> (previous owners; no read access granted)
//   - status: string
//   - Writes are restricted to Cloud Functions (Admin SDK).
//
// Collection: enforcement_audit_logs/{logId}
//   - Server-only immutable audit logs (no client read or write access).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated and App Check token is valid
    function isSecureRequest() {
      // App Check is enforced via Firebase Console.
      // We only check auth here to prevent emulator "undefined property" crashes.
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if userData contains the requested role in its `roles` list
    function hasRoleInData(userData, role) {
      return userData is map &&
        'roles' in userData &&
        userData.roles is list &&
        role in userData.roles;
    }

    // Null-safe role check: verifies user document exists before reading its data
    function hasRole(role) {
      return isSecureRequest() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        hasRoleInData(getUserData(), role);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false; 
    }

    match /users/{userId} {
      // Allow authenticated users to read profiles (needed for local VueFire search)
      allow read: if isSecureRequest();
      // All writes are done via Cloud Functions (setUserRole)
      allow write: if false; 
    }

    match /reports/{reportId} {
      // Agents and Police can read reports
      allow read: if isSecureRequest() && (hasRole('police') || hasRole('agent'));
      allow write: if false;
    }

    match /fines/{fineId} {
      // Police can read all fines
      // Owners can read ONLY their own fines
      allow read: if isSecureRequest() && (hasRole('police') || (hasRole('owner') && resource.data.ownerId == request.auth.uid));
      allow write: if false;
    }

    match /cars/{carId} {
      // Only police or the current owner can read; previous owners (ownershipHistory) have no access
      allow read: if isSecureRequest() && (hasRole('police') || (hasRole('owner') && resource.data.ownerId == request.auth.uid));
      allow write: if false;
    }

    match /enforcement_audit_logs/{logId} {
      // Server-only immutable audit logs written by Admin SDK transactions
      allow read, write: if false;
    }
  }
}
