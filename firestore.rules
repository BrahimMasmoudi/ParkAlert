rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated and App Check token is valid
    function isSecureRequest() {
      // App Check is enforced via Firebase Console.
      // We only check auth here to prevent emulator "undefined property" crashes.
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false; 
    }

    match /users/{userId} {
      // Allow authenticated users to read profiles (needed for local VueFire search)
      allow read: if isSecureRequest();
      // All writes are done via Cloud Functions (setUserRole)
      allow write: if false; 
    }

    match /reports/{reportId} {
      // Agents and Police can read reports
      allow read: if isSecureRequest() && (getUserData().role == 'police' || getUserData().role == 'agent');
      allow write: if false;
    }

    match /fines/{fineId} {
      // Police can read all fines
      // Owners can read ONLY their own fines
      allow read: if isSecureRequest() && (getUserData().role == 'police' || (getUserData().role == 'owner' && resource.data.ownerId == request.auth.uid));
      allow write: if false;
    }

    match /cars/{carId} {
      // Only police or the current owner can read; previous owners (ownershipHistory) have no access
      allow read: if isSecureRequest() && (
        getUserData().role == 'police' ||
        (getUserData().role == 'owner' && resource.data.ownerId == request.auth.uid)
      );
      allow write: if false;
    }

    match /enforcement_audit_logs/{logId} {
      // Server-only immutable audit logs written by Admin SDK transactions
      allow read, write: if false;
    }
  }
}
