{
  "name": "parkalert-functions",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "migrate": "fireway --require=\"ts-node/register\" migrate",
    "test:unit": "vitest run tests/unit",
    "test:emulator": "vitest run tests/emulator",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "fireway": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "firebase": "^13.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
