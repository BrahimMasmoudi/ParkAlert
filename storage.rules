rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSecureRequest() {
      return request.auth != null;
    }

    // Report photos: only authenticated agents can upload to their own folder; police can read
    match /reports/{agentId}/{fileName} {
      allow read:  if isSecureRequest();
      allow write: if isSecureRequest()
                   && request.auth.uid == agentId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Carte Grise uploads: direct reads disabled (served via backend getDocumentUrl signed URLs)
    match /carteGrise/{ownerId}/{fileName} {
      allow read:  if false;
      allow write: if isSecureRequest()
                   && request.auth.uid == ownerId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Transfer documents: direct reads disabled (served via backend getDocumentUrl signed URLs)
    match /transfers/{userId}/{fileName} {
      allow read:  if false;
      allow write: if isSecureRequest()
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
